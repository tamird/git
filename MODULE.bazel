module(
    name = "git",
    version = "2.55.0",
    bazel_compatibility = [">=7.7.0"],
)

bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_rs", version = "0.0.96")
bazel_dep(name = "rules_perl", version = "0.5.0")
bazel_dep(name = "llvm", version = "0.8.9")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "zlib", version = "1.3.1.bcr.8")
bazel_dep(name = "curl", version = "8.8.0.bcr.3")
bazel_dep(name = "libexpat", version = "2.7.1.bcr.1")
bazel_dep(name = "openssl", version = "3.5.4.bcr.0")
bazel_dep(name = "pcre2", version = "10.45")

single_version_override(
    module_name = "curl",
    patches = ["//contrib/bazel:curl-zlib.patch"],
    patch_strip = 1,
)

pcre2_jit_repository = use_repo_rule(
    "//contrib/bazel:pcre2_jit.bzl",
    "pcre2_jit_repository",
)
pcre2_jit_repository(name = "git_pcre2_jit")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
use_repo(rust_toolchains, "default_rust_toolchains")

osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "CFNetwork",
    "CoreFoundation",
    "CoreServices",
    "DiskArbitration",
    "Foundation",
    "IOKit",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
])

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
)
